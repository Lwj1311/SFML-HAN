{
  "schema_version": 1,
  "chapter_id": "ch04",
  "title": "第四章 三十七个名字",
  "speakers": {
    "narrator": { "name": "旁白", "portrait": null },
    "fengan": { "name": "冯安", "portrait": "char_fengan" },
