          "speaker": "guowang",
          "text": "天黑前必须过烽燧，走。",
          "next": null
        }
      ]
    },
    {
      "id": "scene_e2_return",
      "title": "回程",
      "background": "bg_gobi_postroad",
      "entry": "ch1_su_19",
      "trigger": {
        "all": [
          { "flag": "ch1_climax" },
          { "var": "num_su_trust", "op": "gte", "value": 1 }
        ]
      },
      "nodes": [
        {
          "id": "ch1_su_19",
          "type": "narration",
          "text": "回程路上，苏娘走在车后，怀里抱着周敢的旧衣。",
          "next": "ch1_su_20"
        },
        {
          "id": "ch1_su_20",
          "type": "line",
          "speaker": "suhe",
          "text": "货单上那个名字，是他。可货不是他收的。",
          "effects": [
            { "add_clue": "clue_zhougan_used" }
          ],
          "next": "ch1_su_21"
        },
        {
          "id": "ch1_su_21",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你怎么说？",
          "choices": [
            { "id": "believe", "text": "我信你", "next": "ch1_su_22" },
            { "id": "evidence", "text": "证据不够", "next": "ch1_su_22" },
            { "id": "hate", "text": "你恨他吗", "next": "ch1_su_22" }
          ]
        },
        {
          "id": "ch1_su_22",
          "type": "line",
          "speaker": "suhe",
          "variants": [
            {
              "condition": { "choice": "believe" },
              "text": "书佐别信太早。",
              "effects": [
                { "add_var": "num_su_trust", "value": 1 }
              ],
              "next": "ch1_su_23"
            },
            {
              "condition": { "choice": "evidence" },
              "text": "那就查。",
              "next": "ch1_su_23"
            },
            {
              "text": "恨过。后来只想知道他冷不冷。",
              "effects": [
                { "add_var": "num_su_trust", "value": 2 }
              ],
              "next": "ch1_su_23"
            }
          ]
        },
        {
          "id": "ch1_su_23",
          "type": "line",
          "speaker": "suhe",
          "text": "你要抓的是活人，不是名字。",
          "effects": [
            { "add_var": "num_su_trust", "value": 1 }
          ],
          "next": null
        }
      ]
    },
    {
      "id": "scene_f_duyan",
      "title": "杜延的试探",
      "background": "bg_station_courtyard",
