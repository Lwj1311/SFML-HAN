{
  "schema_version": 1,
  "chapter_id": "ch01",
  "title": "第一章 无印之信",
  "speakers": {
    "narrator": { "name": "旁白", "portrait": null },
    "fengan": { "name": "冯安", "portrait": "char_fengan" },
    "zhangji": { "name": "张季", "portrait": "char_yizu" },
    "hanbo": { "name": "韩伯", "portrait": "char_hanbo" },
    "aqi": { "name": "阿耆", "portrait": "char_aqi" },
    "suhe": { "name": "苏娘", "portrait": "char_suhe" },
    "guowang": { "name": "郭望", "portrait": "char_guowang" },
    "baiji": { "name": "白姬", "portrait": "char_baiji" },
    "duyan": { "name": "杜延", "portrait": "char_duyan" }
  },
  "encounters": {
    "enc_ch1_scouts": {
      "name": "红柳滩斥候",
      "enemies": [
        { "id": "xiongnu_scout", "count": 2 }
      ],
      "terrain": "gobi",
      "note": "若 ch1_guowang_hurt 为真，追加 1 名斥候。"
    }
  },
  "scenes": [
    {
      "id": "scene_a_night_letter",
      "title": "夜半无印信",
      "background": "bg_station_interior",
      "entry": "ch1_a01",
      "trigger": { "flag": "prologue_done" },
      "nodes": [
        {
          "id": "ch1_a01",
          "type": "narration",
          "text": "风沙扑打驿门。戌时末，门外忽然响起急促的敲击声。",
          "next": "ch1_a02"
        },
        {
          "id": "ch1_a02",
          "type": "line",
          "speaker": "zhangji",
          "text": "广至驿让交给书佐的，别问是谁写的。",
          "effects": [
            { "set_flag": "ch1_zhangji_seen", "value": true }
          ],
          "next": "ch1_a03"
        },
        {
          "id": "ch1_a03",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你怎么做？",
          "choices": [
            { "id": "inspect", "text": "拆开看", "next": "ch1_a04" },
            { "id": "call_hanbo", "text": "先叫韩伯", "next": "ch1_a05" },
            { "id": "chase", "text": "追出去", "next": "ch1_a03b" }
          ]
        },
        {
          "id": "ch1_a03b",
          "type": "line",
          "speaker": "zhangji",
          "text": "别去红柳滩。",
          "effects": [
            { "set_flag": "ch1_zhangji_warned", "value": true }
          ],
          "next": "ch1_a04"
        },
        {
          "id": "ch1_a04",
          "type": "narration",
          "text": "信上没有封泥，也没有印文。只有两行字：“冬至前，三十七人粮，照旧。广至驿收。”",
          "effects": [
            { "set_flag": "ch1_letter_inspected", "value": true },
            { "add_clue": "clue_unsealed_letter" }
          ],
          "next": "ch1_a05"
        },
        {
          "id": "ch1_a05",
          "type": "line",
          "speaker": "hanbo",
          "text": "这信不该到我们手上。",
          "next": "ch1_a06"
        },
        {
          "id": "ch1_a06",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你问韩伯：",
          "choices": [
            { "id": "ask_names", "text": "三十七人是谁？", "next": "ch1_a07" },
            { "id": "ask_su", "text": "苏娘知道吗？", "next": "ch1_a07" },
            { "id": "silence", "text": "沉默", "next": "ch1_a07" }
          ]
        },
        {
          "id": "ch1_a07",
          "type": "line",
          "speaker": "hanbo",
          "text": "簿上的人早死了。死人不会领粮，活人才会。",
          "effects": [
            { "set_flag": "ch1_hanbo_consulted", "value": true },
            { "add_var": "num_hanbo_trust", "value": 1 }
          ],
          "next": "ch1_a08"
        },
        {
          "id": "ch1_a08",
          "type": "line",
          "speaker": "hanbo",
          "variants": [
            {
              "condition": { "flag": "sq1_01_done" },
              "text": "刀要快，嘴要慢。",
              "next": null
            },
            {
              "text": "天亮再说。",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "scene_a2_aqi_reading",
      "title": "阿耆译读",
      "background": "bg_station_courtyard",
      "entry": "ch1_a09",
      "trigger": { "flag": "ch1_hanbo_consulted" },
      "nodes": [
        {
          "id": "ch1_a09",
          "type": "line",
          "speaker": "aqi",
          "text": "字是汉隶，语序却像胡语。“冬至前”，在匈奴话里更接近“白霜之前”。",
          "effects": [
            { "add_clue": "clue_hu_order" }
          ],
          "next": "ch1_a10"
        },
        {
          "id": "ch1_a10",
          "type": "line",
          "speaker": "aqi",
          "text": "广至驿最近有人换马，马具都是新的。",
          "effects": [
            { "add_clue": "clue_new_harness" }
          ],
          "next": "ch1_a11"
        },
        {
          "id": "ch1_a11",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你怎么回应阿耆？",
          "choices": [
            { "id": "invite", "text": "请他同行", "next": "ch1_a12a" },
            { "id": "ask_caravan", "text": "只问商队", "next": "ch1_a12b" },
            { "id": "suspect", "text": "怀疑他", "next": "ch1_a12c" }
          ]
        },
        {
          "id": "ch1_a12a",
          "type": "line",
          "speaker": "aqi",
          "text": "同行可以。我认得广至驿的马蹄印。",
          "effects": [
            { "set_flag": "ch1_aqi_translated", "value": true },
            { "add_var": "num_aqi_trust", "value": 1 }
          ],
          "next": null
        },
        {
          "id": "ch1_a12b",
          "type": "line",
          "speaker": "aqi",
          "text": "商队从东来，往西去。马是换过的，人没换。",
          "effects": [
            { "set_flag": "ch1_aqi_translated", "value": true }
          ],
          "next": null
        },
        {
          "id": "ch1_a12c",
          "type": "line",
          "speaker": "aqi",
          "text": "我要是匈奴，就不会帮你看这封信。",
          "effects": [
            { "set_flag": "ch1_aqi_translated", "value": true },
            { "add_var": "num_aqi_trust", "value": -1 }
          ],
          "next": null
        }
      ]
    },
    {
      "id": "scene_b_patrol",
      "title": "驿道巡查",
      "background": "bg_gobi_postroad",
      "entry": "ch1_b01",
      "trigger": { "quest": "mq_1_01", "state": "completed" },
      "nodes": [
        {
          "id": "ch1_b01",
          "type": "line",
          "speaker": "guowang",
          "effects": [
            { "set_flag": "ch1_patrol_started", "value": true }
          ],
          "variants": [
            {
              "condition": { "flag": "sq1_04_done" },
              "text": "弩机刚修好，手正痒。昨夜北边有火光，烽燧却没举火。",
              "next": "ch1_b02"
            },
            {
              "text": "这破弩机又卡住了。昨夜北边有火光，烽燧却没举火。",
              "next": "ch1_b02"
            }
          ]
        },
        {
          "id": "ch1_b02",
          "type": "line",
          "speaker": "guowang",
          "text": "张季走的是红柳滩近路，不合驿传规矩。",
          "effects": [
            { "add_clue": "clue_shortcut" }
          ],
          "next": "ch1_b03"
        },
        {
          "id": "ch1_b03",
          "type": "narration",
          "text": "车辙被新沙盖过，马蹄印却一路往北。",
          "effects": [
            { "set_flag": "ch1_tracks_found", "value": true }
          ],
          "next": "ch1_b04"
        },
        {
          "id": "ch1_b04",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "怎么追？",
          "choices": [
            { "id": "follow", "text": "跟车辙", "next": "ch1_b05" },
            { "id": "report", "text": "先回报", "next": "ch1_b04b" },
            { "id": "split", "text": "分头", "next": "ch1_b05" }
          ]
        },
        {
          "id": "ch1_b04b",
          "type": "narration",
          "text": "郭望独自追踪，半晌后捂着腿回来，箭簇还嵌在甲片里。",
          "effects": [
            { "set_flag": "ch1_guowang_hurt", "value": true }
          ],
          "next": "ch1_b05"
        },
        {
          "id": "ch1_b05",
          "type": "narration",
          "text": "两名匈奴斥候从红柳后现身。",
          "next": "ch1_b06"
        },
        {
          "id": "ch1_b06",
          "type": "combat",
          "encounter": "enc_ch1_scouts",
          "on_win": "ch1_b07",
          "on_lose": "ch1_b06_fail"
        },
        {
          "id": "ch1_b06_fail",
          "type": "narration",
          "text": "你眼前一黑，醒来时已被郭望拖回驿道。",
          "next": null
        },
        {
          "id": "ch1_b07",
          "type": "narration",
          "text": "沙窝里找到张季的邮袋和半截弩机悬刀。棨信不见了，只剩半张货单。",
          "effects": [
            { "set_flag": "ch1_scouts_cleared", "value": true },
            { "set_flag": "ch1_crossbow_parts_found", "value": true },
            { "give_item": "item_post_pouch" },
            { "add_clue": "clue_receipt_half" }
          ],
          "next": "ch1_b08"
        },
        {
          "id": "ch1_b08",
          "type": "line",
          "speaker": "guowang",
          "text": "这不是劫道，是灭口。",
          "effects": [
            { "add_var": "num_guowang_trust", "value": 1 },
            { "set_flag": "ch1_patrol_done", "value": true }
          ],
          "next": null
        }
      ]
    },
    {
      "id": "scene_c_guangzhi",
      "title": "广至驿",
      "background": "bg_guangzhi_post",
      "entry": "ch1_bj_01",
      "trigger": { "quest": "mq_1_02", "state": "completed" },
      "nodes": [
        {
          "id": "ch1_bj_01",
          "type": "narration",
          "text": "广至驿门口的酒旗被风扯得直响。白姬倚着门框，像已等了很久。",
          "next": "ch1_bj_02"
        },
        {
          "id": "ch1_bj_02",
          "type": "line",
          "speaker": "baiji",
          "text": "这位就是悬泉置的新书佐？比我想的年轻。",
          "effects": [
            { "set_flag": "ch1_baiji_met", "value": true }
          ],
          "next": "ch1_bj_03"
        },
        {
          "id": "ch1_bj_03",
          "type": "line",
          "speaker": "baiji",
          "text": "广至驿的风硬，喝一口。",
          "next": "ch1_bj_04"
        },
        {
          "id": "ch1_bj_04",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你接过酒卮吗？",
          "choices": [
            { "id": "accept", "text": "接过酒", "next": "ch1_bj_05" },
            { "id": "decline", "text": "推辞", "next": "ch1_bj_05b" },
            { "id": "ask", "text": "先问张季", "next": "ch1_bj_05c" }
          ]
        },
        {
          "id": "ch1_bj_05",
          "type": "line",
          "speaker": "baiji",
          "text": "爽快。张季昨儿也在这喝了一碗，往西去了。",
          "effects": [
            { "add_clue": "clue_baiji_lie" }
          ],
          "next": "ch1_bj_06"
        },
        {
          "id": "ch1_bj_05b",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐谨慎。那便喝碗水。",
          "next": "ch1_bj_06"
        },
        {
          "id": "ch1_bj_05c",
          "type": "line",
          "speaker": "baiji",
          "text": "张季？往西去了。书佐要是急，趁天没黑。",
          "effects": [
            { "add_clue": "clue_baiji_lie" }
          ],
          "next": "ch1_bj_06"
        },
        {
          "id": "ch1_bj_06",
          "type": "narration",
          "text": "她右手食指有新鲜墨痕，袖口沾着一点封泥粉。",
          "effects": [
            { "add_var": "num_baiji_suspicion", "value": 1 },
            { "set_flag": "bj_inkfinger", "value": true }
          ],
          "next": "ch1_bj_07"
        },
        {
          "id": "ch1_bj_07",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐看什么？",
          "next": "ch1_bj_08"
        },
        {
          "id": "ch1_bj_08",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "怎么答？",
          "choices": [
            { "id": "direct", "text": "直说", "next": "ch1_bj_08a" },
            { "id": "cover", "text": "掩饰", "next": "ch1_bj_08b" },
            { "id": "praise", "text": "夸酒", "next": "ch1_bj_08c" }
          ]
        },
        {
          "id": "ch1_bj_08a",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐眼睛太亮，夜里不好睡。",
          "next": "ch1_bj_09"
        },
        {
          "id": "ch1_bj_08b",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐会说话。",
          "next": "ch1_bj_09"
        },
        {
          "id": "ch1_bj_08c",
          "type": "line",
          "speaker": "baiji",
          "text": "酒是去年酿的，书佐识货。",
          "next": "ch1_bj_09"
        },
        {
          "id": "ch1_bj_09",
          "type": "line",
          "speaker": "baiji",
          "text": "马厩在那边。书佐要是想看马，我不拦。",
          "next": "ch1_c01b"
        },
        {
          "id": "ch1_c01b",
          "type": "branch",
          "branches": [
            {
              "condition": { "flag": "ch1_stable_checked" },
              "next": "ch1_c03"
            },
            {
              "next": "ch1_c02"
            }
          ]
        },
        {
          "id": "ch1_c02",
          "type": "narration",
          "text": "一匹马的马具是新的，鞍下夹着红柳刺。",
          "effects": [
            { "set_flag": "ch1_stable_checked", "value": true },
            { "add_var": "num_baiji_suspicion", "value": 1 },
            { "add_clue": "clue_new_harness" }
          ],
          "next": "ch1_c03"
        },
        {
          "id": "ch1_c03",
          "type": "line",
          "speaker": "baiji",
          "text": "商队落下的。",
          "next": "ch1_c04"
        },
        {
          "id": "ch1_c04",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你怎么问？",
          "choices": [
            { "id": "direct_ask", "text": "直问张季", "next": "ch1_c05a" },
            { "id": "buy_horse", "text": "借口买马", "next": "ch1_c05" },
            { "id": "find_water", "text": "假装找水", "next": "ch1_c05" }
          ]
        },
        {
          "id": "ch1_c05a",
          "type": "line",
          "speaker": "baiji",
          "text": "也许往北去了。",
          "effects": [
            { "set_flag": "ch1_baiji_direct_question", "value": true },
            { "add_var": "num_baiji_suspicion", "value": 1 }
          ],
          "next": "ch1_c05"
        },
        {
          "id": "ch1_c05",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐要是找水，灶房在后头。",
          "next": "ch1_c05b"
        },
        {
          "id": "ch1_c05b",
          "type": "branch",
          "branches": [
            {
              "condition": { "var": "num_baiji_suspicion", "op": "gte", "value": 2 },
              "next": "ch1_bj_16"
            },
            {
              "next": "ch1_c06"
            }
          ]
        },
        {
          "id": "ch1_c06",
          "type": "narration",
          "text": "柴房里有一枚旧封泥，和烧剩的信角。印文与无印信上的残印一致。",
          "effects": [
            { "set_flag": "ch1_shed_searched", "value": true },
            { "give_item": "item_seal_clay" },
            { "add_clue": "clue_forged_letter" }
          ],
          "next": "ch1_bj_21"
        },
        {
          "id": "ch1_bj_21",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐找到什么了？",
          "next": "ch1_bj_22"
        },
        {
          "id": "ch1_bj_22",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你怎么应对？",
          "choices": [
            { "id": "show", "text": "拿出封泥", "next": "ch1_bj_23a" },
            { "id": "cover", "text": "都是旧物", "next": "ch1_bj_23b" },
            { "id": "ask_back", "text": "反问她", "next": "ch1_bj_23c" }
          ]
        },
        {
          "id": "ch1_bj_23a",
          "type": "line",
          "speaker": "baiji",
          "text": "广至驿旧年文书多，封泥到处都是。",
          "effects": [
            { "set_flag": "bj_warned", "value": true }
          ],
          "next": "ch1_bj_24"
        },
        {
          "id": "ch1_bj_23b",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐会说话。会说话的人，活得长。",
          "effects": [
            { "add_var": "num_baiji_suspicion", "value": 1 }
          ],
          "next": "ch1_bj_24"
        },
        {
          "id": "ch1_bj_23c",
          "type": "line",
          "speaker": "baiji",
          "text": "我？我只认得酒和钱。",
          "next": "ch1_bj_24"
        },
        {
          "id": "ch1_bj_24",
          "type": "line",
          "speaker": "baiji",
          "text": "有些东西旧了就该埋在土里。挖出来，伤手。",
          "next": "ch1_bj_25"
        },
        {
          "id": "ch1_bj_25",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你怎么回应？",
          "choices": [
            { "id": "warn", "text": "警告她", "next": "ch1_bj_25a" },
            { "id": "retreat", "text": "退让", "next": "ch1_bj_25b" },
            { "id": "ask_zhangji", "text": "问张季", "next": "ch1_bj_26" }
          ]
        },
        {
          "id": "ch1_bj_25a",
          "type": "line",
          "speaker": "baiji",
          "text": "书佐年轻，火气大。",
          "next": "ch1_bj_26"
        },
        {
          "id": "ch1_bj_25b",
          "type": "line",
          "speaker": "baiji",
          "text": "这才对。",
          "next": "ch1_bj_26"
        },
        {
          "id": "ch1_bj_26",
          "type": "line",
          "speaker": "baiji",
          "text": "张季往西去了。书佐要追，趁早。",
          "effects": [
            { "add_var": "num_baiji_suspicion", "value": 1 }
          ],
          "next": "ch1_bj_27"
        },
        {
          "id": "ch1_bj_27",
          "type": "line",
          "speaker": "baiji",
          "text": "路上吃。别在红柳滩停太久。",
          "effects": [
            { "set_flag": "bj_sendoff", "value": true }
          ],
          "next": "ch1_bj_28"
        },
        {
          "id": "ch1_bj_28",
          "type": "choice",
          "speaker": "fengan",
          "prompt": "你接过干粮吗？",
          "choices": [
            { "id": "take", "text": "接过", "next": "ch1_bj_29" },
            { "id": "refuse", "text": "拒绝", "next": "ch1_bj_29b" },
            { "id": "ask_redwillow", "text": "问红柳滩", "next": "ch1_bj_29c" }
          ]
        },
        {
          "id": "ch1_bj_29",
          "type": "line",
          "speaker": "baiji",
