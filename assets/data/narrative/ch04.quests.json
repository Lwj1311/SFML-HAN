  "quests": [
    {
      "id": "mq_4_01",
      "type": "main",
      "title": "名籍",
      "summary": "三十七个人死了，粮还在领。先把他们的名字从原册上抄下来，一个也不能错。",
      "location": "悬泉置名籍架阁",
      "prerequisites": { "flag": "ch4_start" },
      "objectives": [
        {
          "id": "mq_4_01_obj_roster",
          "text": "调出名籍原册",
          "condition": { "flag": "ch4_roster_checked" }
        },
        {
          "id": "mq_4_01_obj_names",
          "text": "抄全三十七个名字",
          "condition": { "flag": "ch4_names_collected" }
        },
        {
          "id": "mq_4_01_obj_erasure",
          "text": "对勘名籍上的削改痕迹",
          "condition": { "flag": "ch4_erasure_found" },
          "optional": true
        }
      ],
      "completion": {
        "all": [
          { "objective": "mq_4_01_obj_roster" },
          { "objective": "mq_4_01_obj_names" }
        ]
      },
      "rewards": [
        { "type": "clue", "id": "clue_register_slips" },
        { "type": "item", "id": "item_register_slips" },
        { "type": "variable", "id": "num_reputation", "delta": 1 }
      ]
    },
    {
      "id": "mq_4_02",
      "type": "main",
      "title": "底本与证词",
      "summary": "一册名籍告不倒一郡的官。底本、证词、口供，能拿到多少，就看这些年你攒下多少人情。",
      "location": "悬泉置与亭狱",
      "prerequisites": { "quest": "mq_4_01", "state": "completed" },
      "objectives": [
        {
          "id": "mq_4_02_obj_hanbo",
          "text": "向韩伯求底本",
          "condition": { "flag": "ch4_hanbo_done" }
        },
        {
          "id": "mq_4_02_obj_su",
          "text": "听苏娘怎么说",
          "condition": { "flag": "ch4_su_done" }
        },
        {
          "id": "mq_4_02_obj_prison",
          "text": "去亭狱走一趟",
          "condition": { "flag": "ch4_prison_done" }
        }
      ],
      "completion": {
        "all": [
          { "objective": "mq_4_02_obj_hanbo" },
          { "objective": "mq_4_02_obj_su" },
          { "objective": "mq_4_02_obj_prison" }
        ]
      },
      "rewards": [
        { "type": "variable", "id": "num_reputation", "delta": 1 }
      ]
    },
    {
      "id": "mq_4_03",
      "type": "main",
      "title": "烽燧雪夜",
