      "completion": {
        "all": [
          { "objective": "mq_4_04_obj_scope" },
          { "objective": "mq_4_04_obj_written" },
          { "objective": "mq_4_04_obj_done" }
        ]
      },
      "rewards": [
        { "type": "item", "id": "item_indictment" },
        { "type": "variable", "id": "num_reputation", "delta": 1 }
      ]
    },
