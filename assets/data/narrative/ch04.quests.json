      "location": "悬泉置烽燧",
      "prerequisites": { "quest": "mq_4_02", "state": "completed" },
      "objectives": [
        {
          "id": "mq_4_03_obj_cleared",
          "text": "击退来烧册的私兵",
          "condition": { "flag": "ch4_beacon_cleared" }
