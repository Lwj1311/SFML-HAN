          "condition": { "flag": "ch4_archive_saved" },
          "optional": true
        }
      ],
      "completion": {
        "all": [
          { "objective": "mq_4_03_obj_cleared" },
          { "objective": "mq_4_03_obj_done" }
        ]
      },
      "rewards": [
        { "type": "variable", "id": "num_reputation", "delta": 1 },
        {
          "type": "clue",
          "id": "clue_commandery_reply",
          "condition": { "flag": "ch4_beacon_lit" }
        }
      ]
    },
    {
